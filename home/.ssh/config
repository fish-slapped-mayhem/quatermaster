# Centrally managed SSH client configuration. Keys are NOT in this repo:
# they arrive at container start via ssh-runtime-keys (from SSH_PRIVATE_KEY_*
# env vars) or via SSH agent forwarding from the host. A missing IdentityFile
# is silently ignored, so both paths coexist.

Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    AddKeysToAgent yes

Host github.com
    User git
    IdentityFile ~/.ssh/id_github
