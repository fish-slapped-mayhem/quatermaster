# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Personal access token with `repo` scope.
# Required for GitHub MCP server, issue tracking, and PR management.
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# SSH private keys, injected into containers at start by ssh-runtime-keys
# (wired as the devcontainer postCreateCommand). Each SSH_PRIVATE_KEY_<NAME>
# becomes ~/.ssh/id_<name> in the container, chmod 600.
#
# .env values must be single-line, so base64-encode the key first:
#   base64 < ~/.ssh/id_ed25519 | tr -d '\n'
# Leave unset to rely on host SSH agent forwarding instead.
SSH_PRIVATE_KEY_GITHUB=
